#!/usr/bin/env bash

set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-3000}"
CLIENT_HOST="${CLIENT_HOST:-127.0.0.1}"
CLIENT_PORT="${CLIENT_PORT:-5173}"

if ! command -v bundle >/dev/null 2>&1; then
  echo "Error: Bundler is not installed or is not available in PATH." >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "Error: npm is not installed or is not available in PATH." >&2
  exit 1
fi

if [ ! -d "$ROOT_DIR/client/node_modules" ]; then
  echo "Warning: client dependencies are missing. Run 'cd client && npm install'." >&2
fi

api_pid=""
client_pid=""

stop_servers() {
  trap - INT TERM EXIT

  if [ -n "$api_pid" ]; then
    kill "$api_pid" 2>/dev/null || true
  fi

  if [ -n "$client_pid" ]; then
    kill "$client_pid" 2>/dev/null || true
  fi

  wait "$api_pid" 2>/dev/null || true
  wait "$client_pid" 2>/dev/null || true
}

trap 'stop_servers; exit 130' INT TERM
trap stop_servers EXIT

echo "Starting Rails API at http://${API_HOST}:${API_PORT}"
(
  cd "$ROOT_DIR" || exit 1
  exec env PORT="$API_PORT" bin/rails server -b "$API_HOST"
) &
api_pid=$!

echo "Starting Vite client at http://${CLIENT_HOST}:${CLIENT_PORT}"
(
  cd "$ROOT_DIR/client" || exit 1
  exec npm run dev -- --host "$CLIENT_HOST" --port "$CLIENT_PORT"
) &
client_pid=$!

echo "Servers are running. Press Ctrl+C to stop both."

while kill -0 "$api_pid" 2>/dev/null && kill -0 "$client_pid" 2>/dev/null; do
  sleep 1
done

echo "One server exited; stopping the other."
exit 1
