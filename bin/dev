#!/usr/bin/env bash

set -u

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
API_HOST="${API_HOST:-127.0.0.1}"
API_PORT="${API_PORT:-3000}"
CLIENT_HOST="${CLIENT_HOST:-127.0.0.1}"
CLIENT_PORT="${CLIENT_PORT:-5173}"

case "$#:${1:-}" in
  0:|1:--lan) ;;
  1:--help|1:-h)
    echo "Usage: bin/dev [--lan]"
    echo "  --lan  Allow access from devices on the same local network."
    exit 0
    ;;
  *)
    echo "Usage: bin/dev [--lan]" >&2
    exit 1
    ;;
esac

if ! command -v bundle >/dev/null 2>&1; then
  echo "Error: Bundler is not installed or is not available in PATH." >&2
  exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "Error: npm is not installed or is not available in PATH." >&2
  exit 1
fi

if [ "${1:-}" = "--lan" ]; then
  if [ -z "${LAN_IP:-}" ]; then
    LAN_IP="$(ruby -rsocket -e '
      addresses = Socket.ip_address_list.select do |address|
        address.ipv4? && !address.ipv4_loopback? && !address.ipv4_multicast? &&
          !address.ip_address.start_with?("169.254.")
      end
      address = addresses.find(&:ipv4_private?) || addresses.first
      puts address.ip_address if address
    ')" || exit 1
  fi

  if [ -z "$LAN_IP" ]; then
    echo "Error: No local IPv4 address found. Set LAN_IP to your local IPv4 address." >&2
    exit 1
  fi

  API_HOST="$LAN_IP"
  CLIENT_HOST="$LAN_IP"
  export DEV_CLIENT_ORIGIN="http://${CLIENT_HOST}:${CLIENT_PORT}"
  export VITE_API_URL="http://${API_HOST}:${API_PORT}"
fi

if [ ! -d "$ROOT_DIR/client/node_modules" ]; then
  echo "Warning: client dependencies are missing. Run 'cd client && npm install'." >&2
fi

api_pid=""
client_pid=""

stop_servers() {
  trap - INT TERM EXIT

  if [ -n "$api_pid" ]; then
    kill "$api_pid" 2>/dev/null || true
  fi

  if [ -n "$client_pid" ]; then
    kill "$client_pid" 2>/dev/null || true
  fi

  wait "$api_pid" 2>/dev/null || true
  wait "$client_pid" 2>/dev/null || true
}

trap 'stop_servers; exit 130' INT TERM
trap stop_servers EXIT

echo "Starting Rails API at http://${API_HOST}:${API_PORT}"
(
  cd "$ROOT_DIR" || exit 1
  exec env PORT="$API_PORT" bin/rails server -b "$API_HOST"
) &
api_pid=$!

echo "Starting Vite client at http://${CLIENT_HOST}:${CLIENT_PORT}"
(
  cd "$ROOT_DIR/client" || exit 1
  vite_args=(--host "$CLIENT_HOST" --port "$CLIENT_PORT")
  if [ "${1:-}" = "--lan" ]; then
    vite_args+=(--strictPort)
  fi
  exec npm run dev -- "${vite_args[@]}"
) &
client_pid=$!

if [ "${1:-}" = "--lan" ]; then
  echo "On your phone, connect to the same Wi-Fi and open ${DEV_CLIENT_ORIGIN}/"
fi
echo "Servers are running. Press Ctrl+C to stop both."

while kill -0 "$api_pid" 2>/dev/null && kill -0 "$client_pid" 2>/dev/null; do
  sleep 1
done

echo "One server exited; stopping the other."
exit 1
